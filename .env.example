# ==============================================================================
# Repodoc Environment Variables Template
# ==============================================================================
# Copy this file to .env (or .env.local) for local development:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - NEVER commit real credentials, tokens, or secrets to version control.
# - Production environments should inject secrets via platform environment
#   settings (e.g., Vercel Project Settings) with strictly scoped access.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
# Uses a local file-backed SQLite database managed via Prisma.
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL):
# When deploying to production (Neon, Supabase, etc.), switch provider in
# prisma/schema.prisma to "postgresql" and use a pooled connection string:
# DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. Public Site Configuration
# ------------------------------------------------------------------------------
# Public origin used for canonical URLs, metadata, and social Open Graph previews.
# Local development: defaults to "https://repodoc.dev" if unset.
NEXT_PUBLIC_SITE_URL="https://repodoc.dev"

# ------------------------------------------------------------------------------
# 3. GitHub API Integration (Public Audits)
# ------------------------------------------------------------------------------
# Optional GitHub personal access token (classic or fine-grained).
# Unauthenticated requests to GitHub's public API are limited to 60 req/hr per IP.
# Providing a token increases the limit to 5,000 req/hr for public repo auditing.
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 4. GitHub OAuth App & Session Configuration (User Authentication & Remediation)
# ------------------------------------------------------------------------------
# Required for user authentication, dashboard history, and 1-click remediation PRs.
# Public report audits remain functional without OAuth credentials configured.
#
# REGISTRATION INSTRUCTIONS:
# Register a GitHub OAuth App at:
#   https://github.com/settings/applications/new
#
# IMPORTANT SECURITY NOTICE:
# - Create an OAuth App (under Developer Settings > OAuth Apps), NOT a GitHub App.
# - GitHub App client IDs begin with "Iv" and are rejected before sign-in.
#
# OAuth App Configuration:
# - Application name: Repodoc (Local)
# - Homepage URL: http://localhost:3000 (or your production domain)
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
#
# Requested Scopes:
#   read:user, user:email, public_repo, workflow
#
# NEXTAUTH_SECRET / AUTH_SECRET:
# 32-byte base64 string used to sign session cookies and encrypt JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Supported Auth.js alias:
# AUTH_SECRET=""

# NEXTAUTH_URL / AUTH_URL:
# Canonical URL of the application. In local development, use http://localhost:3000.
# In production, must be an HTTPS URL matching your production domain.
NEXTAUTH_URL="http://localhost:3000"
# Supported Auth.js alias:
# AUTH_URL="http://localhost:3000"

# GITHUB_CLIENT_ID / AUTH_GITHUB_ID:
# Client ID from your registered GitHub OAuth App (must NOT start with "Iv").
GITHUB_CLIENT_ID=""
# Supported Auth.js alias:
# AUTH_GITHUB_ID=""

# GITHUB_CLIENT_SECRET / AUTH_GITHUB_SECRET:
# Client secret generated for your GitHub OAuth App.
GITHUB_CLIENT_SECRET=""
# Supported Auth.js alias:
# AUTH_GITHUB_SECRET=""

# SESSION NOTES:
# - Keep NEXTAUTH_SECRET stable across deployments to prevent invalidating user sessions.
# - Expired provider tokens require signing in again; automatic refresh is not implemented.
