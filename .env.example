# Repodoc Environment Variables
DATABASE_URL="file:./dev.db"

# Public origin for canonical URLs and social previews (set to your deployment URL)
# NEXT_PUBLIC_SITE_URL="https://repodoc.dev"

# GitHub API token (optional for higher rate limits during development)
# GITHUB_TOKEN=""
# GitHub OAuth App (optional for public audits; all four required for sign-in)
# Register at https://github.com/settings/applications/new (OAuth Apps, not GitHub Apps).
# GitHub App client IDs beginning with Iv are unsupported and rejected before sign-in.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# Homepage URL: http://localhost:3000
# GitHub OAuth App callback: http://localhost:3000/api/auth/callback/github
# Use HTTPS and a separate OAuth App for production.
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# Keep NEXTAUTH_SECRET stable when replacing credentials; restart and sign in again.
# Previous sessions are invalidated when switching OAuth clients. No database migration.
# Requested scopes: read:user user:email public_repo workflow
# Expired provider tokens require signing in again; automatic refresh is not implemented.
